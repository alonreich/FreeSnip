<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="freesnip.forms.ScrollCaptureWindow"
        Title="Scroll Capture"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        SystemDecorations="None"
        Topmost="True"
        WindowState="Normal"
        CanResize="False"
        ShowInTaskbar="False"
        Focusable="True"
        Cursor="Cross">
    <Grid Name="MainRoot">
        <Canvas Name="MainCanvas" Background="Transparent" PointerMoved="OnPointerMoved" PointerPressed="OnPointerPressed" PointerWheelChanged="OnPointerWheelChanged">
            <Border Name="HighlightBorder" BorderBrush="{DynamicResource FreeSnipScrollAccentBrush}" BorderThickness="4" IsVisible="False" IsHitTestVisible="False">
                <Border.Background>
                    <SolidColorBrush Color="{StaticResource FreeSnipScrollAccentColor}" Opacity="0.13" />
                </Border.Background>
            </Border>
            <Border Name="InstructionBorder" CornerRadius="8" Padding="14,8" BorderBrush="{DynamicResource FreeSnipScrollAccentBrush}" BorderThickness="1" IsHitTestVisible="False">
                <Border.Background>
                    <SolidColorBrush Color="{StaticResource FreeSnipCanvasColor}" Opacity="0.93" />
                </Border.Background>
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <!-- ISSUE_019: pulse animation attaches directly via the class, no code-behind required. -->
                    <Ellipse Name="RecordingDot" Classes="pulse" Width="12" Height="12" Fill="{DynamicResource FreeSnipDestructiveHoverBrush}" IsVisible="False" VerticalAlignment="Center">
                        <Ellipse.Styles>
                            <Style Selector="Ellipse.pulse">
                                <Style.Animations>
                                    <Animation Duration="0:0:1" IterationCount="Infinite">
                                        <KeyFrame KeyTime="0:0:0"><Setter Property="Opacity" Value="1.0"/></KeyFrame>
                                        <KeyFrame KeyTime="0:0:0.5"><Setter Property="Opacity" Value="0.3"/></KeyFrame>
                                        <KeyFrame KeyTime="0:0:1"><Setter Property="Opacity" Value="1.0"/></KeyFrame>
                                    </Animation>
                                </Style.Animations>
                            </Style>
                        </Ellipse.Styles>
                    </Ellipse>
                    <TextBlock Name="InstructionText" Text="Point at a window" Foreground="{DynamicResource FreeSnipScrollAccentBrush}" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Name="StatusText" Text="Left-click or Space to start" Foreground="{DynamicResource FreeSnipPrimaryTextBrush}" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="Esc/right-click = exit" Foreground="{DynamicResource FreeSnipSecondaryTextBrush}" FontSize="14"/>
                </StackPanel>
            </Border>
        </Canvas>
        <!-- Safe position in the bottom corner with non-occluding idle opacity and hover highlight. -->
        <Button Name="ExitButton" Content="Exit Scroll Capture" AutomationProperties.Name="Exit scroll capture"
                MinWidth="150" MinHeight="34" Cursor="Hand" HorizontalContentAlignment="Center"
                Background="{DynamicResource FreeSnipSecondaryButtonBrush}" Foreground="{DynamicResource FreeSnipPrimaryTextBrush}"
                Click="OnExitClick" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="20"
                Opacity="0.45">
            <Button.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                </Transitions>
            </Button.Transitions>
            <Button.Styles>
                <Style Selector="Button#ExitButton:pointerover">
                    <Setter Property="Opacity" Value="1.0" />
                </Style>
            </Button.Styles>
        </Button>
    </Grid>
</Window>