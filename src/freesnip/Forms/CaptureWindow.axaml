<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="freesnip.forms.CaptureWindow"
        Title="Capture Selection"
        AutomationProperties.Name="Screen capture selection overlay"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        SystemDecorations="None"
        Topmost="True"
        WindowState="Normal"
        CanResize="False"
        ShowInTaskbar="False"
        Focusable="True"
        Cursor="Cross">
    <Canvas Name="MainCanvas" Background="{DynamicResource FreeSnipHitTestScrimBrush}" PointerPressed="OnPointerPressed" PointerMoved="OnPointerMoved" PointerReleased="OnPointerReleased">
        <Image Name="BackgroundImage" Stretch="None" IsHitTestVisible="False" Opacity="1.0" AutomationProperties.AccessibilityView="Raw" />
        <Border Name="HighlightBorder" BorderBrush="{DynamicResource FreeSnipAccentBrush}" BorderThickness="3" IsVisible="False" IsHitTestVisible="False">
            <Border.Background>
                <SolidColorBrush Color="{DynamicResource FreeSnipAccentColor}" Opacity="0.2"/>
            </Border.Background>
        </Border>
        <Border Name="Rubberband" BorderBrush="{DynamicResource FreeSnipAccentBrush}" BorderThickness="2" IsVisible="False" IsHitTestVisible="False">
            <Border.Background>
                <SolidColorBrush Color="{DynamicResource FreeSnipAccentColor}" Opacity="0.13"/>
            </Border.Background>
        </Border>
        
        <Border Name="DimensionBadge" CornerRadius="4" Padding="6,2" BorderBrush="{DynamicResource FreeSnipAccentBrush}" BorderThickness="1" IsVisible="False" IsHitTestVisible="False">
            <Border.Background>
                <SolidColorBrush Color="{DynamicResource FreeSnipCanvasColor}" Opacity="0.8"/>
            </Border.Background>
            <TextBlock Name="DimensionText" Text="0 x 0" Foreground="{DynamicResource FreeSnipPrimaryTextBrush}" FontSize="11" FontWeight="Bold"/>
        </Border>

        <Border Name="WindowSnapBadge" CornerRadius="4" Padding="8,3" BorderBrush="{DynamicResource FreeSnipPrimaryTextBrush}" BorderThickness="1" IsVisible="False" IsHitTestVisible="False">
            <Border.Background>
                <SolidColorBrush Color="{DynamicResource FreeSnipAccentColor}" Opacity="0.86"/>
            </Border.Background>
            <TextBlock Text="Window selected" Foreground="{DynamicResource FreeSnipPrimaryTextBrush}" FontSize="11" FontWeight="Bold"/>
        </Border>

        <Border Name="InstructionBorder" CornerRadius="20" Padding="12,6" BorderBrush="{DynamicResource FreeSnipSecondaryButtonBrush}" BorderThickness="1" IsHitTestVisible="False">
            <Border.Background>
                <SolidColorBrush Color="{DynamicResource FreeSnipCanvasColor}" Opacity="0.8"/>
            </Border.Background>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Name="InstructionText" Text="Drag to capture or hover window" Foreground="{DynamicResource FreeSnipSecondaryTextBrush}" FontSize="11"/>
                <TextBlock Name="CopyText" Text="C = Copy" Foreground="{DynamicResource FreeSnipSecondaryTextBrush}" FontSize="11"/>
                <TextBlock Name="OcrText" Text="T = Text capture" Foreground="{DynamicResource FreeSnipSecondaryTextBrush}" FontSize="11"/>
                <TextBlock Text="Esc = Cancel" Foreground="{DynamicResource FreeSnipSecondaryTextBrush}" FontSize="11"/>
            </StackPanel>
        </Border>

        <Border Name="OcrProcessingStatus" CornerRadius="4" Padding="12,8" BorderBrush="{DynamicResource FreeSnipAccentBrush}" BorderThickness="1" IsVisible="False" IsHitTestVisible="False">
            <Border.Background>
                <SolidColorBrush Color="{DynamicResource FreeSnipCanvasColor}" Opacity="0.93"/>
            </Border.Background>
            <StackPanel Orientation="Vertical" Spacing="8" MinWidth="180">
                <TextBlock Text="Processing OCR..." Foreground="{DynamicResource FreeSnipPrimaryTextBrush}" HorizontalAlignment="Center" FontSize="12"/>
                <ProgressBar IsIndeterminate="True" MinWidth="160" Height="6" HorizontalAlignment="Stretch"
                             Foreground="{DynamicResource FreeSnipAccentBrush}"
                             AutomationProperties.Name="Text recognition in progress"/>
            </StackPanel>
        </Border>

        <Border Name="MagnifierPanel" CornerRadius="80" BorderBrush="{DynamicResource FreeSnipAccentBrush}" BorderThickness="3" Background="{DynamicResource FreeSnipMagnifierBackgroundBrush}" IsVisible="False" IsHitTestVisible="False" ClipToBounds="True">
            <Viewbox Width="160" Height="160">
                <Canvas Width="160" Height="160">
                    <Image Name="MagnifierImage" Stretch="None" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                    <Ellipse Width="154" Height="154" Margin="3,3,0,0" Stroke="{DynamicResource FreeSnipPrimaryTextBrush}" StrokeThickness="1" Fill="Transparent" />
                    <Path Data="M 80 0 L 80 160 M 0 80 L 160 80" Stroke="{DynamicResource FreeSnipAccentBrush}" StrokeThickness="1" Opacity="0.33" />
                    <Ellipse Width="10" Height="10" Margin="75,75,0,0">
                        <Ellipse.Fill>
                            <SolidColorBrush Color="{DynamicResource FreeSnipAccentColor}" Opacity="0.53"/>
                        </Ellipse.Fill>
                    </Ellipse>
                </Canvas>
            </Viewbox>
        </Border>
    </Canvas>
</Window>
