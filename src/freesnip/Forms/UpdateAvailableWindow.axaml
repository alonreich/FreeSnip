<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="freesnip.forms.UpdateAvailableWindow"
        Title="FreeSnip Update Available"
        Width="520" Height="360"
        Background="{DynamicResource FreeSnipCanvasBrush}"
        CanResize="False"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="14">
        <Border Background="{DynamicResource FreeSnipPanelDarkBrush}" CornerRadius="8"
                BorderBrush="{DynamicResource FreeSnipAccentBrush}" BorderThickness="1.5" Padding="18">
            <Grid RowDefinitions="Auto, *, Auto">
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,10" Spacing="6">
                    <TextBlock Text="New Version Available"
                               Foreground="{DynamicResource FreeSnipAccentBrush}"
                               FontSize="16" FontWeight="Bold"
                               HorizontalAlignment="Center" TextAlignment="Center"/>
                    <Border Background="{DynamicResource FreeSnipCanvasBrush}" CornerRadius="4"
                            BorderBrush="{DynamicResource FreeSnipSeparatorBrush}" BorderThickness="1"
                            Padding="12,4" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <TextBlock Name="YourVersionText" Foreground="{DynamicResource FreeSnipSecondaryTextBrush}"
                                       FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="➔" Foreground="{DynamicResource FreeSnipAccentBrush}"
                                       FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Name="NewVersionText" Foreground="{DynamicResource FreeSnipPrimaryTextBrush}"
                                       FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Scrollable release notes fetched from GitHub release -->
                <Expander Name="ReleaseNotesExpander" Grid.Row="1" Header="What's New in this Release"
                          AutomationProperties.Name="What's new in this release"
                          Cursor="Hand"
                          IsExpanded="True"
                          Background="{DynamicResource FreeSnipCanvasBrush}"
                          Foreground="{DynamicResource FreeSnipPrimaryTextBrush}"
                          BorderBrush="{DynamicResource FreeSnipSeparatorBrush}"
                          BorderThickness="1" CornerRadius="6"
                          Margin="0,0,0,12" VerticalAlignment="Stretch">
                    <Border Background="{DynamicResource FreeSnipCanvasBrush}"
                            Padding="8" Margin="2">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="130">
                            <TextBlock Name="ReleaseNotesText"
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       Foreground="{DynamicResource FreeSnipPrimaryTextBrush}"
                                       LineHeight="18"/>
                        </ScrollViewer>
                    </Border>
                </Expander>

                <!-- Footer Action Bar -->
                <Grid Grid.Row="2" ColumnDefinitions="Auto, *">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Button Name="SkipBtn" Content="Skip this version"
                                AutomationProperties.Name="Skip this version"
                                Cursor="Hand"
                                Background="Transparent"
                                Foreground="{DynamicResource FreeSnipDimTextBrush}"
                                BorderThickness="0"
                                Padding="2,6" FontSize="11"
                                VerticalAlignment="Center"/>

                        <TextBlock Text="•" Foreground="{DynamicResource FreeSnipSeparatorBrush}" VerticalAlignment="Center" FontSize="10"/>

                        <Button Name="NeverBtn" Content="Don't check again"
                                AutomationProperties.Name="Don't check again"
                                Cursor="Hand"
                                Background="Transparent"
                                Foreground="{DynamicResource FreeSnipDimTextBrush}"
                                BorderThickness="0"
                                Padding="2,6" FontSize="11"
                                VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                        <Button Name="RemindLaterBtn" Content="Remind Me Later"
                                AutomationProperties.Name="Remind me later"
                                Cursor="Hand" IsCancel="True"
                                Background="{DynamicResource FreeSnipSecondaryButtonBrush}"
                                Foreground="{DynamicResource FreeSnipPrimaryTextBrush}"
                                BorderBrush="{DynamicResource FreeSnipSeparatorBrush}"
                                BorderThickness="1" MinWidth="120"
                                HorizontalContentAlignment="Center"
                                Padding="14,6" CornerRadius="4"/>

                        <Button Name="UpdateNowBtn" Content="Update Now"
                                AutomationProperties.Name="Update now"
                                Cursor="Hand" IsDefault="True"
                                Background="{DynamicResource FreeSnipAccentBrush}"
                                Foreground="{DynamicResource FreeSnipPrimaryTextBrush}"
                                FontWeight="SemiBold" MinWidth="100"
                                HorizontalContentAlignment="Center"
                                Padding="16,6" CornerRadius="4"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
