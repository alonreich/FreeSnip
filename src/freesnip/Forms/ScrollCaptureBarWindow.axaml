<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="freesnip.forms.ScrollCaptureBarWindow"
        Title="Scroll Capture Controller"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        SystemDecorations="None"
        Topmost="True"
        ShowActivated="False"
        Focusable="False"
        CanResize="False"
        ShowInTaskbar="False"
        Width="580"
        Height="68"
        WindowStartupLocation="Manual"
        Cursor="Arrow">
    <Border Background="#F2181A1F"
            BorderBrush="{DynamicResource FreeSnipScrollAccentBrush}"
            BorderThickness="1.5"
            CornerRadius="34"
            Padding="16,8"
            Margin="6"
            BoxShadow="0 8 30 0 #B3000000"
            PointerPressed="OnPillPointerPressed">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" VerticalAlignment="Center">
            <!-- Pulsing REC Indicator -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="4,0,14,0">
                <Ellipse Classes="pulse" Width="12" Height="12" Fill="{DynamicResource FreeSnipDestructiveHoverBrush}" VerticalAlignment="Center">
                    <Ellipse.Styles>
                        <Style Selector="Ellipse.pulse">
                            <Style.Animations>
                                <Animation Duration="0:0:1" IterationCount="Infinite">
                                    <KeyFrame KeyTime="0:0:0"><Setter Property="Opacity" Value="1.0"/></KeyFrame>
                                    <KeyFrame KeyTime="0:0:0.5"><Setter Property="Opacity" Value="0.25"/></KeyFrame>
                                    <KeyFrame KeyTime="0:0:1"><Setter Property="Opacity" Value="1.0"/></KeyFrame>
                                </Animation>
                            </Style.Animations>
                        </Style>
                    </Ellipse.Styles>
                </Ellipse>
                <TextBlock Text="REC" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource FreeSnipDestructiveHoverBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Status Indicator & User Guidance -->
            <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,14,0">
                <TextBlock Name="ScreensBadge" Text="Recording started. Scroll down now using your mouse wheel." FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource FreeSnipPrimaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Name="SubtextHint" Text="Space / Enter finishes · Esc cancels" FontSize="10.5" Foreground="{DynamicResource FreeSnipSecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!-- Green On-Screen Finish Button -->
            <Button Grid.Column="2" Name="FinishButton" Content="✓ Finish &amp; Open Editor" Click="OnFinishClick"
                    AutomationProperties.Name="Finish scroll capture and open editor"
                    Background="{DynamicResource FreeSnipSuccessBrush}" Foreground="{DynamicResource FreeSnipPrimaryTextBrush}"
                    FontWeight="Bold" FontSize="11.5"
                    CornerRadius="16" Padding="14,6" Margin="0,0,8,0" Cursor="Hand">
                <Button.Styles>
                    <Style Selector="Button#FinishButton:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="{DynamicResource FreeSnipSuccessHoverBrush}" />
                    </Style>
                </Button.Styles>
            </Button>

            <!-- Red On-Screen Cancel Button -->
            <Button Grid.Column="3" Name="CancelButton" Content="✕ Cancel (Esc)" Click="OnCancelClick"
                    AutomationProperties.Name="Cancel scroll capture"
                    Background="{DynamicResource FreeSnipDestructiveBrush}" Foreground="{DynamicResource FreeSnipPrimaryTextBrush}"
                    FontWeight="Bold" FontSize="11.5"
                    CornerRadius="16" Padding="12,6" Margin="0" Cursor="Hand">
                <Button.Styles>
                    <Style Selector="Button#CancelButton:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="{DynamicResource FreeSnipDestructiveHoverBrush}" />
                    </Style>
                </Button.Styles>
            </Button>
        </Grid>
    </Border>
</Window>
