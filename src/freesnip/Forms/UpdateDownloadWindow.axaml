<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="freesnip.forms.UpdateDownloadWindow"
        Title="Updating FreeSnip"
        Width="460" Height="220"
        Background="{DynamicResource FreeSnipCanvasBrush}"
        CanResize="False"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="14">
        <Border Background="{DynamicResource FreeSnipPanelDarkBrush}" CornerRadius="8"
                BorderBrush="{DynamicResource FreeSnipAccentBrush}" BorderThickness="1.5" Padding="18">
            <Grid RowDefinitions="Auto, *, Auto">
                <TextBlock Name="TitleText" Grid.Row="0" Text="Updating FreeSnip"
                           Foreground="{DynamicResource FreeSnipAccentBrush}"
                           FontSize="16" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,8"/>

                <StackPanel Grid.Row="1" Spacing="8" VerticalAlignment="Center" Margin="6,0">
                    <TextBlock Name="HeadlineText" Text="Downloading update package…"
                               Foreground="{DynamicResource FreeSnipPrimaryTextBrush}"
                               FontSize="13" FontWeight="SemiBold"
                               TextAlignment="Center" TextWrapping="Wrap"/>

                    <ProgressBar Name="Progress" Minimum="0" Maximum="100" Height="8"
                                 AutomationProperties.Name="Update download progress"
                                 Background="{DynamicResource FreeSnipCanvasBrush}"
                                 Foreground="{DynamicResource FreeSnipAccentBrush}"
                                 CornerRadius="4"
                                 HorizontalAlignment="Stretch"/>

                    <TextBlock Name="StatusText" Text="Starting…"
                               Foreground="{DynamicResource FreeSnipSecondaryTextBrush}"
                               FontSize="12" TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Downloading Buttons Panel -->
                <StackPanel Name="DownloadingButtonsPanel" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center"
                            Spacing="12" Margin="0,8,0,0">
                    <Button Name="CancelBtn" Content="Cancel Download" MinWidth="130"
                            AutomationProperties.Name="Cancel download"
                            Cursor="Hand" IsCancel="True"
                            Background="{DynamicResource FreeSnipCanvasBrush}"
                            Foreground="{DynamicResource FreeSnipSecondaryTextBrush}"
                            BorderBrush="{DynamicResource FreeSnipSeparatorBrush}"
                            BorderThickness="1" Padding="14,6" CornerRadius="4"
                            HorizontalContentAlignment="Center"/>
                </StackPanel>

                <!-- Ready to Install Action Buttons -->
                <StackPanel Name="ReadyButtonsPanel" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                            Spacing="10" Margin="0,8,0,0" IsVisible="False">
                    <Button Name="ContinueWorkingBtn" Content="Later" Cursor="Hand" IsCancel="True"
                            AutomationProperties.Name="Later"
                            Background="{DynamicResource FreeSnipSecondaryButtonBrush}"
                            Foreground="{DynamicResource FreeSnipPrimaryTextBrush}"
                            BorderBrush="{DynamicResource FreeSnipSeparatorBrush}" BorderThickness="1"
                            MinWidth="90" HorizontalContentAlignment="Center"
                            Padding="14,6" CornerRadius="4"/>

                    <Button Name="RestartNowBtn" Content="Restart Now" Cursor="Hand" IsDefault="True"
                            AutomationProperties.Name="Restart Now"
                            Background="{DynamicResource FreeSnipAccentBrush}"
                            Foreground="{DynamicResource FreeSnipPrimaryTextBrush}"
                            FontWeight="SemiBold"
                            MinWidth="110" HorizontalContentAlignment="Center"
                            Padding="16,6" CornerRadius="4"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
