<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="freesnip.forms.UpdateDownloadWindow"
        Title="Updating FreeSnip"
        Width="520" MinWidth="520" SizeToContent="Height"
        Background="{DynamicResource FreeSnipCanvasBrush}"
        CanResize="False"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="16">
        <Border Background="{DynamicResource FreeSnipPanelDarkBrush}" CornerRadius="8"
                BorderBrush="{DynamicResource FreeSnipAccentBrush}" BorderThickness="2" Padding="20">
            <Grid RowDefinitions="Auto, Auto, Auto">
                <TextBlock Name="TitleText" Grid.Row="0" Text="Updating FreeSnip"
                           Foreground="{DynamicResource FreeSnipAccentBrush}"
                           FontSize="18" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,15"/>

                <StackPanel Grid.Row="1" Spacing="12" Margin="10,0,10,15">
                    <TextBlock Name="HeadlineText" Text="Downloading update package…"
                               Foreground="{DynamicResource FreeSnipPrimaryTextBrush}"
                               FontSize="14" FontWeight="SemiBold"
                               TextAlignment="Center" TextWrapping="Wrap"/>

                    <ProgressBar Name="Progress" Minimum="0" Maximum="100" Height="14"
                                 AutomationProperties.Name="Update download progress"
                                 Background="{DynamicResource FreeSnipCanvasBrush}"
                                 Foreground="{DynamicResource FreeSnipAccentBrush}"
                                 HorizontalAlignment="Stretch"/>

                    <TextBlock Name="StatusText" Text="Starting…"
                               Foreground="{DynamicResource FreeSnipSecondaryTextBrush}"
                               FontSize="12" TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Downloading Buttons Panel -->
                <StackPanel Name="DownloadingButtonsPanel" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center"
                            Spacing="15" Margin="0,5,0,0">
                    <Button Name="CancelBtn" Content="CANCEL DOWNLOAD" MinWidth="140"
                            AutomationProperties.Name="Cancel download"
                            Cursor="Hand" IsCancel="True"
                            Background="{DynamicResource FreeSnipCanvasBrush}"
                            Foreground="{DynamicResource FreeSnipSecondaryTextBrush}"
                            BorderBrush="{DynamicResource FreeSnipSeparatorBrush}"
                            BorderThickness="1" Padding="12,6" CornerRadius="4"
                            HorizontalContentAlignment="Center"/>
                </StackPanel>

                <!-- Ready to Install Action Buttons -->
                <StackPanel Name="ReadyButtonsPanel" Grid.Row="2" Spacing="10" Margin="0,10,0,0" IsVisible="False">
                    <Button Name="RestartNowBtn" Cursor="Hand" IsDefault="True"
                            AutomationProperties.Name="Restart The App Now (to finish the upgrade process)"
                            Background="{DynamicResource FreeSnipAccentBrush}"
                            Foreground="{DynamicResource FreeSnipPrimaryTextBrush}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Padding="16,10" CornerRadius="6">
                        <TextBlock TextAlignment="Center" TextWrapping="Wrap">
                            <Run Text="Restart The App Now" FontSize="14" FontWeight="Bold" /><LineBreak />
                            <Run Text="(to finish the upgrade process)" FontSize="11" />
                        </TextBlock>
                    </Button>

                    <Button Name="ContinueWorkingBtn" Cursor="Hand" IsCancel="True"
                            AutomationProperties.Name="Continue Working (I will restart the app when I am done working)"
                            Background="{DynamicResource FreeSnipPanelDarkBrush}"
                            Foreground="{DynamicResource FreeSnipPrimaryTextBrush}"
                            BorderBrush="{DynamicResource FreeSnipSeparatorBrush}" BorderThickness="1"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Padding="14,8" CornerRadius="6">
                        <TextBlock TextAlignment="Center" TextWrapping="Wrap">
                            <Run Text="Continue Working" FontSize="13" FontWeight="SemiBold" /><LineBreak />
                            <Run Text="(I will restart the app when I am done working)" FontSize="11" Foreground="{DynamicResource FreeSnipSecondaryTextBrush}" />
                        </TextBlock>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
